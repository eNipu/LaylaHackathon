# Optional locally: without a key, generation returns a labeled demo fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host
NEXT_PUBLIC_META_PIXEL_ID=
# Local SQLite. For serverless, use a hosted libsql:// URL, not a local file.
DATABASE_URL=file:events.db
DATABASE_AUTH_TOKEN=
