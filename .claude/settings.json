{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git --no-pager status *)",
      "Bash(git --no-pager diff *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(/bin/rm *)",
      "Bash(git *push*--force*)",
      "Bash(git *push* -f)",
      "Bash(git *push* -f *)",
      "Bash(*.env*)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./**/node_modules/**)",
      "Read(./**/.next/**)",
      "Read(./**/out/**)",
      "Read(./**/.taste-skill/**)",
      "Read(./public/images/**)",
      "Read(./**/*.lock)",
      "Read(./**/package-lock.json)",
      "Read(./**/*.log)"
    ]
  }
}
